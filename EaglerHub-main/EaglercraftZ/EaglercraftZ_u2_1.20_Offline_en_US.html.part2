";
    const epkBytes = Uint8Array.from(atob(epkBase64), c => c.charCodeAt(0));

    const epkBlob = new Blob([epkBytes], {
        type: "application/octet-stream"
    });

    window.__offlineAssetsURL = URL.createObjectURL(epkBlob);

    // ===== CREATE SAFE SELF URL =====
    const currentHTML = document.documentElement.outerHTML;
    const selfBlob = new Blob([currentHTML], {
        type: "text/html"
    });

    window.__offlineSelfURL = URL.createObjectURL(selfBlob);

    // ===== FETCH PATCH =====
    const originalFetch = window.fetch;
    if(originalFetch) {
        window.fetch = function(resource, init) {
            let url = resource;

            if(typeof resource === "object" && resource.url) {
                url = resource.url;
            }

            if(typeof url === "string") {
                if(url.includes("assets.epk")) {
                    return originalFetch(window.__offlineAssetsURL, init);
                }

                // Replace blocked file:// self loads
                if(url.startsWith("file:") && url.endsWith(".html")) {
                    return originalFetch(window.__offlineSelfURL, init);
                }
            }

            return originalFetch(resource, init);
        };
    }

    // ===== XHR PATCH =====
    const origOpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function(method, url) {
